        <mxCell id="app" value="app container (Next.js :3000)" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#94c11e;swimlaneFillColor=#f6fbe9;strokeColor=#6e9116;fontColor=#1a1a1a;" vertex="1" parent="1">
