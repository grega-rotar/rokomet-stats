<mxfile host="app.diagrams.net">
  <diagram id="Data-pipeline" name="Data pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="rokomet-stats: stats pipeline from the RZS API to stats.db, and who reads it" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#2c3e50;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="rzs" value="RZS public API · infostat.rokometna-zveza.si/api/public" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#999999;swimlaneFillColor=#f5f5f5;strokeColor=#999999;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="290" height="400" as="geometry" />
        </mxCell>
        <mxCell id="ep0" value="GET /seasons" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontSize=11;" vertex="1" parent="rzs">
          <mxGeometry x="15" y="42" width="260" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ep1" value="GET /leaguesNew/{sezona}" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontSize=11;" vertex="1" parent="rzs">
          <mxGeometry x="15" y="86" width="260" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ep2" value="GET /pregledKrogiLiga/{s}/sezona/{l}" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontSize=11;" vertex="1" parent="rzs">
          <mxGeometry x="15" y="130" width="260" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ep3" value="POST /tekmeLige/{l}/sezona/{s}" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontSize=11;" vertex="1" parent="rzs">
          <mxGeometry x="15" y="174" width="260" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ep4" value="GET /pregledTekme/{id}" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontSize=11;" vertex="1" parent="rzs">
          <mxGeometry x="15" y="218" width="260" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ep5" value="GET /tekma/{id}/ekipa/{t}/igralci" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontSize=11;" vertex="1" parent="rzs">
          <mxGeometry x="15" y="262" width="260" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ep6" value="GET /pregledAkcijTekma/{id}/tekma" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontSize=11;" vertex="1" parent="rzs">
          <mxGeometry x="15" y="306" width="260" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ep7" value="GET /natisniStatistikaTekme/{id} (PDF)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontSize=11;" vertex="1" parent="rzs">
          <mxGeometry x="15" y="350" width="260" height="34" as="geometry" />
        </mxCell>
        <mxCell id="crawler" value="crawler container (python3, same image as app)" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#94c11e;swimlaneFillColor=#f6fbe9;strokeColor=#6e9116;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="360" y="50" width="1290" height="400" as="geometry" />
        </mxCell>
        <mxCell id="sched" value="&lt;b&gt;schedule&lt;/b&gt;&lt;br&gt;every 6 h" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#94c11e;strokeColor=#6e9116;fontColor=#1a1a1a;" vertex="1" parent="crawler">
          <mxGeometry x="20" y="50" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="crawl" value="&lt;b&gt;scripts/crawl.py&lt;/b&gt;&lt;br&gt;seasons → leagues → rounds → matches&lt;br&gt;~1 req/s, finished matches fetched once" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#94c11e;strokeColor=#6e9116;fontColor=#1a1a1a;" vertex="1" parent="crawler">
          <mxGeometry x="20" y="160" width="170" height="130" as="geometry" />
        </mxCell>
        <mxCell id="parse" value="&lt;b&gt;parsers&lt;/b&gt;&lt;br&gt;JSON → rows&lt;br&gt;parse_zones.py: PDF goal zones (9 zones, misses, 7m)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#94c11e;strokeColor=#6e9116;fontColor=#1a1a1a;" vertex="1" parent="crawler">
          <mxGeometry x="240" y="160" width="190" height="130" as="geometry" />
        </mxCell>
        <mxCell id="checks" value="checks (per match)" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#94c11e;swimlaneFillColor=#f6fbe9;strokeColor=#6e9116;fontColor=#1a1a1a;" vertex="1" parent="crawler">
          <mxGeometry x="480" y="50" width="330" height="290" as="geometry" />
        </mxCell>
        <mxCell id="c0" value="player goals = score" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#94c11e;strokeColor=#6e9116;fontColor=#1a1a1a;" vertex="1" parent="checks">
          <mxGeometry x="20" y="45" width="290" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="play-by-play final = score" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#94c11e;strokeColor=#6e9116;fontColor=#1a1a1a;" vertex="1" parent="checks">
          <mxGeometry x="20" y="103" width="290" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="PDF score = score" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#94c11e;strokeColor=#6e9116;fontColor=#1a1a1a;" vertex="1" parent="checks">
          <mxGeometry x="20" y="161" width="290" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="zones + 7m = score" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#94c11e;strokeColor=#6e9116;fontColor=#1a1a1a;" vertex="1" parent="checks">
          <mxGeometry x="20" y="219" width="290" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ok" value="&lt;b&gt;pass&lt;/b&gt;&lt;br&gt;write rows to stats.db" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#94c11e;strokeColor=#6e9116;fontColor=#1a1a1a;" vertex="1" parent="crawler">
          <mxGeometry x="860" y="60" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bad" value="&lt;b&gt;fail&lt;/b&gt;&lt;br&gt;record in checks table (ok = 0)&lt;br&gt;match kept out of stats" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#f8d7da;strokeColor=#c0392b;fontColor=#7b1d1d;" vertex="1" parent="crawler">
          <mxGeometry x="860" y="240" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rev" value="&lt;b&gt;review&lt;/b&gt;&lt;br&gt;AI review via claude-pool: render PDF page, explain failure&lt;br&gt;→ fix parser → rebuild" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=12;fillColor=#fffbe6;strokeColor=#c9b458;fontColor=#333333;align=left;spacingLeft=8;fontSize=11;align=center;" vertex="1" parent="crawler">
          <mxGeometry x="1080" y="220" width="190" height="130" as="geometry" />
        </mxCell>
        <mxCell id="vol" value="app_data volume (/data)" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#36a9e0;swimlaneFillColor=#eef8fd;strokeColor=#36a9e0;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="360" y="500" width="1290" height="190" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;raw response cache&lt;/b&gt;&lt;br&gt;/data/cache, gzip, key = URL&lt;br&gt;(PDFs kept only with zones)" style="shape=cylinder3;boundedLbl=1;size=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#36a9e0;strokeColor=#1f7fae;fontColor=#ffffff;" vertex="1" parent="vol">
          <mxGeometry x="220" y="45" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="stats" value="&lt;b&gt;stats.db&lt;/b&gt;&lt;br&gt;seasons, competitions, matches,&lt;br&gt;player_match, goalkeeper_match,&lt;br&gt;events, team_zones, team_shooting,&lt;br&gt;&lt;b&gt;checks&lt;/b&gt;" style="shape=cylinder3;boundedLbl=1;size=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#36a9e0;strokeColor=#1f7fae;fontColor=#ffffff;" vertex="1" parent="vol">
