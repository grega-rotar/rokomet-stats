        </mxCell>
        <mxCell id="appdb" value="&lt;b&gt;app.db&lt;/b&gt;&lt;br&gt;users, chats, messages" style="shape=cylinder3;boundedLbl=1;size=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#36a9e0;strokeColor=#1f7fae;fontColor=#ffffff;" vertex="1" parent="vol">
          <mxGeometry x="1070" y="45" width="190" height="110" as="geometry" />
