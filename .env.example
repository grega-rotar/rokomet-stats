# See specs/architecture.md for what each one does. Copy to .env.local for local dev.
DATABASE_PATH=./data/app.db
WORK_DIR=./data/work
# Shared login password until auth is decided (specs/open-questions.md).
APP_PASSWORD=change-me
# Signs session cookies: openssl rand -hex 32
AUTH_SECRET=
# The command to run. Plain `claude` works too for local dev.
CLAUDE_BIN=claude-pool
# Model for replies (an alias like haiku or sonnet, or a full model name). Default: sonnet.
CLAUDE_MODEL=
# Comma-separated tool names that exist in a reply, passed to --tools. Empty = no tools.
CLAUDE_TOOLS=
# Comma-separated, passed to --allowedTools. Empty = the flag is not passed.
CLAUDE_ALLOWED_TOOLS=
MAX_PARALLEL_RUNS=6
RUN_TIMEOUT_SECONDS=600
# CLAUDE_POOL_DIR=/home/app/.config/claude-pool
# CLAUDE_POOL_STATE=/data/claude-pool-state.json
